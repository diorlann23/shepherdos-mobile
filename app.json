{
  "expo": {
    "name": "ShepherdOS",
    "slug": "shepherdos-mobile",
    "owner": "lann12",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/758664e6-9ade-4d5d-b83d-1ebe1f630d11",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shepherdos.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock ShepherdOS and keep your church’s records private."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shepherdos.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#12141C"
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock ShepherdOS and keep your church’s records private."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ShepherdOS uses the camera to scan members’ QR cards when checking people in to a service.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B2A5B",
          "defaultChannel": "default"
        }
      ]
    ],
    "scheme": "shepherdos",
    "extra": {
      "defaultServer": "https://shepherdoss.vercel.app",
      "eas": {
        "projectId": "758664e6-9ade-4d5d-b83d-1ebe1f630d11"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
